@model mini_red_social1.Models.Tipo_Interaccion

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>Tipo_Interaccion</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="nombre" class="control-label"></label>
                <input asp-for="nombre" class="form-control" />
                <span asp-validation-for="nombre" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="descripcion" class="control-label"></label>
                <input asp-for="descripcion" class="form-control" />
                <span asp-validation-for="descripcion" class="text-danger"></span>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="requiere_recurso" /> @Html.DisplayNameFor(model => model.requiere_recurso)
                </label>
            </div>
            <div class="form-group form-check">
                <label class="form-check-label">
                    <input class="form-check-input" asp-for="esta_activo" /> @Html.DisplayNameFor(model => model.esta_activo)
                </label>
            </div>
            <div class="form-group">
                <label asp-for="creado_en" class="control-label"></label>
                <input asp-for="creado_en" type="datetime-local" class="form-control" readonly />
                <span asp-validation-for="creado_en" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="modificado_en" class="control-label"></label>
                <input asp-for="modificado_en" type="datetime-local" class="form-control" />
                <span asp-validation-for="modificado_en" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="borrado_en" class="control-label"></label>
                <input asp-for="borrado_en" type="datetime-local" class="form-control" />
                <span asp-validation-for="borrado_en" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

