                @Html.DisplayFor(modelItem => item.descripcion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.EstadoActual)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.NivelPrivacidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.horario_inicio)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.horario_fin)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.creado_en)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.modificado_en)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.borrado_en)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.interacciones_id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.interacciones_id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.interacciones_id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
