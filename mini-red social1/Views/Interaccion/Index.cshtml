@model IEnumerable<mini_red_social1.Models.Interaccion_social>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.tipo_interaccion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.usuario_id)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.titulo)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.descripcion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.EstadoActual)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.NivelPrivacidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.horario_inicio)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.horario_fin)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.creado_en)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.modificado_en)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.borrado_en)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.tipo_interaccion.tipo_interaccion_id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.usuario_id.user_id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.titulo)
            </td>
