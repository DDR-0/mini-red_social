@model IEnumerable<mini_red_social1.Models.Registro_auditoria>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.id_user)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.accion)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.entidad_afectada)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.id_entidad)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.direccion_ip)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.usuario_agente)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.payload_antes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.payload_despues)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.creado_en)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.id_user.user_id)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.accion)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.entidad_afectada)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.id_entidad)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.direccion_ip)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.usuario_agente)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.payload_antes)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.payload_despues)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.creado_en)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.auditlog_id">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.auditlog_id">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.auditlog_id">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
